{
  "version": 1,
  "project": {
    "name": "anzi",
    "kind": "poc"
  },
  "commands": {
    "format": "",
    "lint": "cd NextJS && npm run lint",
    "typecheck": "cd NextJS && npx tsc --noEmit",
    "test": "cd NextJS && npm test",
    "build": "cd NextJS && npm run build",
    "run": ""
  },
  "gate": {
    "run": [
      "typecheck",
      "lint",
      "test"
    ]
  },
  "guard": {
    "extra_deny": [
      "(^|[;&|[:space:]])yarn[[:space:]]+(install|add|upgrade|remove)"
    ],
    "extra_ask": [
      "vercel[[:space:]]+(deploy|--prod|env|rm|remove)",
      "mongo(sh|dump|import|restore|export)([[:space:]]|$)",
      "npm[[:space:]]+audit[[:space:]]+fix",
      "npm[[:space:]]+(install|i|update|uninstall)[[:space:]]"
    ]
  },
  "jarvis_kit_version": "0.10.0"
}
